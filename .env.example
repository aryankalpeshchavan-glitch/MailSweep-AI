# ============================================================================
# MailSweep AI - environment configuration template
#
# Copy this file to `.env` (repo root) and fill in real values.
# NEVER commit the real .env file.
# Every variable below is documented in docs/ENGINEERING_PLAN.md as well.
# ============================================================================

# --- Core ---
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Root cryptographic secret. Used to derive:
#   - OAuth state signing key (HMAC)
#   - OAuth token encryption key (Fernet)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production. In development an ephemeral key is generated with a
# warning if this is empty (sessions/tokens won't survive restarts).
SECRET_KEY=

# Public base URL of THIS backend (no trailing slash).
BASE_URL=http://localhost:8000

# Comma-separated origins allowed for CORS and CSRF Origin checking.
FRONTEND_ORIGINS=http://localhost:3000

# --- Database ---
# Production MUST be PostgreSQL, e.g.:
#   postgresql://user:password@host:5432/mailsweep
# (the app normalizes the scheme to the pg8000 driver automatically)
# Development fallback when empty: local SQLite file (backend/mailsweep-dev.db)
DATABASE_URL=

# --- Redis / background jobs ---
# Required in production (Celery broker). When empty in development, jobs run
# inline in-process (fine for local dev and tests).
REDIS_URL=redis://localhost:6379/0

# --- Google OAuth (Gmail features) ---
# Create in Google Cloud Console. See docs/GOOGLE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Usually leave empty: defaults to {BASE_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- AI (OPTIONAL - app is fully functional without it) ---
# Anthropic API key used only to resolve ambiguous classifications.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Limits & tuning (safe defaults shown) ---
MAX_MESSAGES_PER_ANALYSIS=20000
DEFAULT_RETENTION_YEARS=3
AI_MAX_MESSAGES_PER_JOB=200
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_EXPENSIVE_PER_MINUTE=5
SESSION_TTL_DAYS=14
